NODE_ENV=production
PORT=7421
CLIENT_PORT=7422
# DATA_DIR and UPLOAD_DIR are resolved to absolute paths under the repo
# (never inside client/dist). Defaults: ../data and ../data/uploads relative to server/.
# DATA_DIR=../data
# UPLOAD_DIR=../data/uploads
# MAX_FILE_SIZE_MB=2048
# AUTO_DELETE_HOURS=24
# ACCESS_KEY=
# SESSION_TTL_HOURS=168
# PRINT_KEY=true
# COOKIE_SECURE=false
